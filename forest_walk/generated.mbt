///|
/// Committed generated runtime data for the Forest Walk scene: the fairy
/// sprite sheet, the three parallax scenery layers and the canonical audio
/// metadata. The generated data is committed as the runtime source of truth:
/// every build (web, device, CI, fresh clone) consumes it directly. Optional
/// local authoring PNGs and converters can regenerate it deterministically.
/// The committed scenery uses a 120x160 indexed sample grid with a 2x
/// presentation scale. The generated hex stream stays compact in source and
/// is expanded once to a 19,200-byte index array per layer; rendering samples
/// each source pixel into a 2x2 logical block on the 240x320 canvas.

///|
/// Hand-written support for the generated scenery layer files. Every
/// generated `build_*_layer` function assembles one of these records from a
/// compact palette plus one-byte hex-encoded pixel indices. Each scenery
/// layer stores only a 120x160 index grid (19,200 bytes) plus a small palette;
/// the renderer presents it at 2x scale onto the 240x320 Canvas. Layers are
/// built once at scene construction.
pub(all) struct IndexedLayer {
  width : Int
  height : Int
  /// Integer presentation scale from stored samples to logical Canvas pixels.
  scale : Int
  /// Opaque palette colors, the lookup target of `indices`. The slot at
  /// `transparent_index`, when present, is never sampled by the renderer.
  palette : FixedArray[@core.Color]
  /// Row-major one-byte palette indices, exactly `width * height` entries.
  indices : FixedArray[Byte]
  /// Palette index reserved for transparency; `None` for fully opaque layers.
  transparent_index : Int?
}

///|
/// Assembles one IndexedLayer from generated data, decoding the hex-encoded
/// index stream. The data is validated here so a malformed generated file
/// aborts loudly at startup instead of corrupting the scene.
fn indexed_layer(
  width~ : Int,
  height~ : Int,
  scale~ : Int,
  palette~ : Array[@core.Color],
  encoded~ : Array[String],
  transparent_index~ : Int?,
) -> IndexedLayer {
  if width <= 0 || height <= 0 || scale <= 0 {
    abort("generated layer dimensions and scale must be positive")
  }
  let pixel_count = width * height
  let indices : FixedArray[Byte] = FixedArray::make(pixel_count, 0)
  let mut high = -1
  let mut count = 0
  for block in encoded {
    for digit in block {
      let code = digit.to_int()
      let nibble = if code >= 48 && code <= 57 {
        code - 48
      } else if code >= 65 && code <= 70 {
        code - 55
      } else {
        abort("generated layer has a non-hex character in its index stream")
      }
      if high < 0 {
        high = nibble
      } else {
        if count >= pixel_count {
          abort("generated layer has more indices than width * height")
        }
        indices[count] = (high * 16 + nibble).to_byte()
        count += 1
        high = -1
      }
    }
  }
  if high >= 0 || count != pixel_count {
    abort("generated layer index count does not match width * height")
  }
  let colors = FixedArray::from_array(palette)
  for i in 0..<count {
    if indices[i].to_int() >= colors.length() {
      abort("generated layer references a palette index outside the palette")
    }
  }
  match transparent_index {
    Some(t) =>
      if t < 0 || t >= colors.length() {
        abort("generated layer transparent index is outside the palette")
      }
    None => ()
  }
  { width, height, scale, palette: colors, indices, transparent_index, }
}

