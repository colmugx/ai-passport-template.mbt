///|
/// Canonical committed music artifact metadata for
/// `assets/forest_walk.pcm` (PCM16 LE, mono, 16000 Hz, headerless). The
/// constants derive only from the artifact's byte size so the application
/// can wrap the playback position at the canonical loop duration with
/// integer arithmetic, without parsing audio metadata at runtime.

///|
/// Canonical normalized PCM sample rate in hertz (PCM16 LE, mono,
/// headerless).
pub const AUDIO_SAMPLE_RATE : Int = 16000

///|
/// Total PCM sample count of the canonical artifact (byte length / 2).
pub const AUDIO_TOTAL_SAMPLES : Int = 1222400

///|
/// Duration of one loop of the canonical artifact in microseconds
/// (total_samples * 1_000_000 / sample_rate, integer division).
pub const AUDIO_DURATION_US : Int64 = 76400000L
