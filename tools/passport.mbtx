// Project build dispatcher: the real builds live in the passport CLI of the
// published SDK package (colmugx/ai-passport pinned in moon.mod), run from
// the copy Moon materializes for this module under .mooncakes/. The
// registry carries no prebuilt moonx asset for this release (moonx
// colmugx/ai-passport/cmd/passport@<version> answers "Prebuilt wasm asset
// does not exist"), so the CLI runs from the materialized published
// package; switch to that moonx form when a release ships the asset.
//
//   moon run tools/passport.mbtx assets
//   moon run tools/passport.mbtx build web
//   moon run tools/passport.mbtx build device
//   moon run tools/passport.mbtx dev
//
// Never flashes hardware.

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}

///|
/// The passport CLI package inside the Moon-materialized published SDK
/// dependency (Moon's public .mooncakes layout, the same tree the CLI
/// itself reads its Host assets from).
const CLI_PACKAGE : String = ".mooncakes/colmugx/ai-passport/src/cmd/passport"

async fn run_step(cmd : @shell.Cmd, what : String) -> Unit {
  println("passport: \{what}")
  let code = cmd.each_line(line => println("  \{line}"))
  if code != 0 {
    fail("passport: \{what} failed with exit code \{code}")
  }
}

///|
/// One normal Moon project operation so Moon itself resolves and
/// materializes the published dependency into .mooncakes — a fresh clone
/// needs this before the CLI package path exists (`moon update` refreshes
/// the registry index only). The check result is cached, so on later runs
/// this is a no-op guard hit.
async fn ensure_dependencies_materialized() -> Unit {
  if @fs.exists("\{CLI_PACKAGE}/moon.pkg") {
    return
  }
  run_step(
    @shell.Cmd::Cmd("moon", ["check", "--target", "native"]),
    "resolving the published SDK dependency (first run)",
  )
  guard @fs.exists("\{CLI_PACKAGE}/moon.pkg") else {
    fail(
      "passport: the published SDK CLI did not materialize at \{CLI_PACKAGE}; verify moon.mod and run moon update",
    )
  }
}

///|
/// Runs one passport CLI command of the published SDK package against this
/// project. `--project` crosses as an absolute path because the CLI resolves
/// it relative to its own working directory.
async fn passport_cli(args : Array[String], what : String) -> Unit {
  ensure_dependencies_materialized()
  guard @env.current_dir() is Some(root) else {
    fail("passport: cannot resolve the project root (no current directory)")
  }
  let argv : Array[String] = [
    "run", "--target", "wasm", CLI_PACKAGE, "--",
  ]
  for arg in args {
    argv.push(arg)
  }
  argv.push("--project")
  argv.push(root)
  run_step(
    @shell.Cmd::Cmd("moon", argv),
    what,
  )
}

async fn main {
  let args = @env.args()
  let command = if args.length() >= 2 { args[1] } else { "" }
  guard @fs.exists("moon.mod") else {
    fail("passport: run from the repository root (moon.mod not found)")
  }
  match command {
    "assets" =>
      run_step(@shell.Cmd("moon", ["run", "tools/assets.mbtx"]), "assets")
    "build" => {
      let target = if args.length() >= 3 { args[2] } else { "" }
      match target {
        "web" | "device" => {
          // Exactly one asset normalization per build (graphics + the
          // canonical ffmpeg normalization), then the SDK CLI owns the rest.
          run_step(@shell.Cmd("moon", ["run", "tools/assets.mbtx"]), "assets")
        }
        _ => ()
      }
      match target {
        "web" =>
          passport_cli(["build", "--host", "web"], "build web (SDK passport CLI)")
        "device" =>
          passport_cli(
            ["build", "--host", "folotoy-ai-passport"],
            "build device (SDK passport CLI; never flashes)",
          )
        _ =>
          fail("passport build: expected 'web' or 'device', got: '\{target}'")
      }
    }
    "dev" => {
      // The published CLI owns the dev server (build, serve, URL); PORT
      // stays honored from the previous tools/dev.mbtx workflow.
      let dev_args : Array[String] = ["dev"]
      match @env.get_env_var("PORT") {
        Some(port) => {
          dev_args.push("--port")
          dev_args.push(port)
        }
        None => ()
      }
      passport_cli(dev_args, "dev (SDK passport CLI)")
    }
    _ =>
      fail(
        "passport: unknown command '\{command}'; expected one of: assets, build web, build device, dev",
      )
  }
}
