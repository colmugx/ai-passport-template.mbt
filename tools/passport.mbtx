import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}

const PASSPORT_CLI : String = "colmugx/ai-passport/cmd/passport@0.0.4"

async fn run_step(cmd : @shell.Cmd, what : String) -> Unit {
  println("passport: \{what}")
  let code = cmd.each_line(line => println("  \{line}"))
  if code != 0 {
    fail("passport: \{what} failed with exit code \{code}")
  }
}

async fn ensure_sdk_materialized() -> Unit {
  if @fs.exists(".mooncakes/colmugx/ai-passport/moon.mod") {
    return
  }
  run_step(
    @shell.Cmd::Cmd("moon", ["check", "--target", "native"]),
    "resolving SDK dependency",
  )
  guard @fs.exists(".mooncakes/colmugx/ai-passport/moon.mod") else {
    fail("passport: ai-passport dependency was not materialized")
  }
}

async fn passport_cli(args : Array[String], what : String) -> Unit {
  ensure_sdk_materialized()
  guard @env.current_dir() is Some(root) else {
    fail("passport: cannot resolve project root")
  }
  let argv : Array[String] = [PASSPORT_CLI]
  for arg in args {
    argv.push(arg)
  }
  argv.push("--project")
  argv.push(root)
  run_step(@shell.Cmd::Cmd("moonx", argv), what)
}

async fn main {
  let args = @env.args()
  let command = if args.length() >= 2 { args[1] } else { "" }
  guard @fs.exists("moon.mod") else {
    fail("passport: run from the repository root")
  }
  match command {
    "assets" =>
      run_step(@shell.Cmd("moon", ["run", "tools/assets.mbtx"]), "assets")
    "build" => {
      let target = if args.length() >= 3 { args[2] } else { "" }
      match target {
        "web" | "device" =>
          run_step(@shell.Cmd("moon", ["run", "tools/assets.mbtx"]), "assets")
        _ => ()
      }
      match target {
        "web" => passport_cli(["build", "--host", "web"], "build web")
        "device" =>
          passport_cli(
            ["build", "--host", "folotoy-ai-passport"],
            "build device",
          )
        _ => fail("passport build: expected 'web' or 'device', got '\{target}'")
      }
    }
    "dev" => {
      let dev_args : Array[String] = ["dev"]
      match @env.get_env_var("PORT") {
        Some(port) => {
          dev_args.push("--port")
          dev_args.push(port)
        }
        None => ()
      }
      passport_cli(dev_args, "dev")
    }
    _ =>
      fail(
        "passport: expected one of: assets, build web, build device, dev",
      )
  }
}
