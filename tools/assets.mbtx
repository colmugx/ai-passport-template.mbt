import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
}

async fn run_step(cmd : @shell.Cmd, what : String) -> Unit {
  println("assets: \{what}")
  let code = cmd.each_line(line => println("  \{line}"))
  if code != 0 {
    fail("assets: \{what} failed with exit code \{code}")
  }
}

async fn main {
  guard @fs.exists("moon.mod") else {
    fail("assets: run from the repository root")
  }
  run_step(
    @shell.Cmd("python3", ["tools/compile_sprite.py"]),
    "compiling sprite sheet",
  )
  run_step(
    @shell.Cmd("python3", ["tools/compile_layers.py"]),
    "compiling parallax layers",
  )
  run_step(
    @shell.Cmd("python3", ["tools/compile_audio.py"]),
    "normalizing audio",
  )
  guard @fs.exists(".passport/assets/forest_walk.pcm") else {
    fail("assets: canonical PCM missing")
  }
}
