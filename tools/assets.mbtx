// One deterministic asset build for the Forest Walk project (temporary
// Project Contract v0 tooling; a future SDK passport CLI replaces this).
//
//   moon run tools/assets.mbtx
//
// Orchestrates the existing Python asset compilers exactly once per run:
// the fairy sprite sheet, the three forest layers, and the ONE canonical
// audio normalization (authored WAV/MP3 -> .passport/assets/forest_walk.pcm
// + the committed src/forest_walk/generated/audio_meta.mbt). Each step
// fails loudly on missing sources, ambiguous inputs, missing ffmpeg, an
// over-budget PCM, or generated-data errors.

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
}

async fn run_step(cmd : @shell.Cmd, what : String) -> Unit {
  println("assets: \{what}")
  let code = cmd.each_line(line => println("  \{line}"))
  if code != 0 {
    fail("assets: \{what} failed with exit code \{code}")
  }
}

async fn main {
  guard_repo_root()
  run_step(
    @shell.Cmd("python3", ["tools/compile_sprite.py"]),
    "compiling fairy walk sprite sheet",
  )
  run_step(
    @shell.Cmd("python3", ["tools/compile_layers.py"]),
    "compiling forest parallax layers",
  )
  run_step(
    @shell.Cmd("python3", ["tools/compile_audio.py"]),
    "normalizing canonical audio (.passport/assets/forest_walk.pcm)",
  )
  let pcm_ready = @fs.exists(".passport/assets/forest_walk.pcm")
  guard pcm_ready else {
    fail("assets: canonical PCM missing after compile_audio.py")
  }
  println("assets: done")
}

///|
async fn guard_repo_root() -> Unit {
  let at_root = @fs.exists("moon.mod")
  guard at_root else {
    fail(
      "assets: run from the repository root (moon.mod not found in the current directory)",
    )
  }
}
