// Temporary Project Contract v0 dev server (a future SDK passport CLI
// replaces this).
//
//   moon run tools/dev.mbtx
//
// Builds the new wasm web bundle (tools/build.mbtx web), serves
// .passport/web over localhost with a python3 static file server, prints
// the configured URL, and keeps serving until interrupted. No browser
// runtime logic lives here; the SDK Web Host runs the application.

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}

const DEV_URL_PATH : String = "index.html?pcm=./assets/forest_walk.pcm&pcmLoop=1"

async fn run_step(cmd : @shell.Cmd, what : String) -> Unit {
  println("dev: \{what}")
  let code = cmd.each_line(line => println("  \{line}"))
  if code != 0 {
    fail("dev: \{what} failed with exit code \{code}")
  }
}

async fn main {
  let args = @env.args()
  if args.length() > 1 {
    fail("dev: unexpected arguments: \{Repr(args[1:])} (dev takes none; PORT env var selects the port)")
  }
  guard @fs.exists("moon.mod") else {
    fail("dev: run from the repository root (moon.mod not found)")
  }
  let port = match @env.get_env_var("PORT") {
    Some(p) => p
    None => "8000"
  }
  run_step(@shell.Cmd("moon", ["run", "tools/build.mbtx", "web"]), "building web bundle")
  guard @fs.exists(".passport/web/app.wasm") else {
    fail("dev: bundle incomplete: .passport/web/app.wasm missing")
  }
  let url = "http://127.0.0.1:\{port}/\{DEV_URL_PATH}"
  println("")
  println("Forest Walk (wasm, SDK DOM auto-boot, PCM asset mode, loop): \{url}")
  println("Up/DOWN volume, OK mute — handled by the MoonBit app inside app.wasm.")
  println("Press Ctrl-C to stop.")
  // Serve until interrupted; the server shares the process group, so Ctrl-C
  // stops both.
  run_step(
    @shell.Cmd(
      "python3",
      [
        "-m", "http.server", port, "--bind", "127.0.0.1", "--directory",
        ".passport/web",
      ],
    ),
    "serving .passport/web",
  )
}
