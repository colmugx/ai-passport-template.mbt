// Project web build (a future SDK passport CLI may replace this).
//
//   moon run tools/build.mbtx web
//
// Web build pipeline:
//   1. one deterministic asset build (tools/assets.mbtx)
//   2. compile the runtime_wasm entry package for the MoonBit wasm target
//      against the PUBLISHED ai-passport SDK resolved by moon.mod
//   3. assemble .passport/web/: app.wasm, the SDK Web Host files
//      copied byte-for-byte from the resolved published package, and the
//      canonical PCM copied byte-for-byte into assets/
//
// The bundle's only web entry is the SDK's own index.html, booted by the
// SDK 0.0.3 DOM auto-boot in passport-host.js. The project-specific host
// configuration is generic URL parameters on that page:
//   index.html?pcm=./assets/forest_walk.pcm&pcmLoop=1
// This template owns no browser bootstrap JavaScript. Authored MP3/WAV are
// never served.

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
}

const BUNDLE_DIR : String = ".passport/web"

const WASM_ARTIFACT : String = "_build/wasm/release/build/runtime_wasm/runtime_wasm.wasm"

const CANONICAL_PCM : String = ".passport/assets/forest_walk.pcm"

const HOST_FILE : String = "hosts/web/passport-host.js"

async fn run_step(cmd : @shell.Cmd, what : String) -> Unit {
  println("build web: \{what}")
  let code = cmd.each_line(line => println("  \{line}"))
  if code != 0 {
    fail("build web: \{what} failed with exit code \{code}")
  }
}

async fn main {
  let args = @env.args()
  let target = if args.length() >= 2 { args[1] } else { "" }
  guard target == "web" else {
    fail("build: expected 'web', got: '\{target}'")
  }
  guard @fs.exists("moon.mod") else {
    fail("build web: run from the repository root (moon.mod not found)")
  }
  // 1. Exactly one asset normalization per build workflow.
  run_step(@shell.Cmd("moon", ["run", "tools/assets.mbtx"]), "assets")
  // 2. Compile the wasm application against the published SDK dependency.
  run_step(
    @shell.Cmd("moon", ["build", "--target", "wasm", "--release"]),
    "compiling runtime_wasm (moon target wasm, release)",
  )
  guard @fs.exists(WASM_ARTIFACT) else {
    fail("build web: wasm artifact missing: \{WASM_ARTIFACT}")
  }
  // 3. Assemble the bundle.
  let sdk = sdk_package_dir()
  println("build web: SDK package: \{sdk}")
  if !@fs.exists("\{BUNDLE_DIR}/assets") {
    @fs.mkdir("\{BUNDLE_DIR}/assets", recursive=true, permission=0o755)
  }
  copy_file(WASM_ARTIFACT, "\{BUNDLE_DIR}/app.wasm")
  copy_file("\{sdk}/hosts/web/passport-host.js", "\{BUNDLE_DIR}/passport-host.js")
  copy_file("\{sdk}/hosts/web/pcm-worklet.js", "\{BUNDLE_DIR}/pcm-worklet.js")
  copy_file("\{sdk}/hosts/web/index.html", "\{BUNDLE_DIR}/index.html")
  copy_file(CANONICAL_PCM, "\{BUNDLE_DIR}/assets/forest_walk.pcm")
  // The SDK index.html is the only web entry: drop any stale
  // template-generated bootstrap page left by an older build.
  if @fs.exists("\{BUNDLE_DIR}/app.html") {
    @fs.remove("\{BUNDLE_DIR}/app.html")
  }
  println("build web: bundle assembled at \{BUNDLE_DIR}")
  println(
    "build web: entry: /index.html?pcm=./assets/forest_walk.pcm&pcmLoop=1 (SDK DOM auto-boot, PCM asset mode, loop)",
  )
}

///|
/// Locates the resolved PUBLISHED ai-passport package (never a sibling SDK
/// checkout, never GitHub main): first the module-local mooncakes
/// resolution — which is exactly the package `moon build` compiled against —
/// then the versioned user dependency cache. Fails clearly when the Web
/// Host assets cannot be materialized.
async fn sdk_package_dir() -> String {
  let module_resolution = ".mooncakes/colmugx/ai-passport"
  if @fs.exists("\{module_resolution}/\{HOST_FILE}") {
    return module_resolution
  }
  guard @env.get_env_var("HOME") is Some(home) else {
    fail("build web: HOME is not set; cannot locate the moon dependency cache")
  }
  let cache_root = "\{home}/.moon/cache/deps/v1/sources/colmugx/ai-passport"
  if @fs.exists(cache_root) {
    let versions = @fs.readdir(cache_root)
    let hits : Array[String] = []
    for v in versions {
      if @fs.exists("\{cache_root}/\{v}/\{HOST_FILE}") {
        hits.push(v)
      }
    }
    if hits.length() == 1 {
      return "\{cache_root}/\{hits[0]}"
    }
    if hits.length() > 1 {
      fail(
        "build web: ambiguous SDK cache (\{hits.length()} versions ship hosts/web); resolve the dependency first: moon update && moon build --target wasm --release",
      )
    }
  }
  fail(
    "build web: published ai-passport package not resolved (no .mooncakes entry, no usable user cache); run 'moon update' and retry",
  )
}

///|
async fn copy_file(from : String, to : String) -> Unit {
  let data = @fs.read_file(from)
  @fs.write_file(to, data)
}
